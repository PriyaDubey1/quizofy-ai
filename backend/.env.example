# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=quizofy

# Secret used to sign JWT auth tokens - use any long random string
JWT_SECRET=change_this_to_a_long_random_string

# Groq API key (free) - get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Comma separated list of allowed origins for CORS. Set to your Vercel URL after deploying.
CORS_ORIGINS=*
